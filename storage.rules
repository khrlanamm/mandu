rules_version = '2';

// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Bukti laporan: nama file mengikuti ID laporan (acak). Tidak bisa di-list
    // dan tidak bisa ditimpa/dihapus dari aplikasi.
    match /laporan_bukti/{fileName} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && resource == null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // File lain (mis. gambar artikel) hanya dikelola lewat Firebase console.
    match /{allPaths=**} {
      allow get: if request.auth != null;
    }
  }
}
