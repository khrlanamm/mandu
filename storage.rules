rules_version = '2';

// Deploy: firebase deploy --only storage
// Memakai cross-service rules (firestore.get) agar akses lampiran sama dengan akses laporan.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function inSchool(schoolId) {
      return signedIn() && request.auth.token.get('sid', '') == schoolId;
    }

    function roleIn(schoolId, roles) {
      return inSchool(schoolId) && request.auth.token.get('role', '') in roles;
    }

    function ticketPath(schoolId, ticketId) {
      return /databases/(default)/documents/schools/$(schoolId)/tickets/$(ticketId);
    }

    function ownerPath(schoolId, ticketId) {
      return /databases/(default)/documents/schools/$(schoolId)/ticketOwners/$(ticketId);
    }

    function ownsTicket(schoolId, ticketId) {
      return signedIn()
        && firestore.exists(ownerPath(schoolId, ticketId))
        && firestore.get(ownerPath(schoolId, ticketId)).data.uid == request.auth.uid;
    }

    function inTicketUnit(schoolId, ticketId) {
      return roleIn(schoolId, ['konselor', 'petugas'])
        && firestore.get(ticketPath(schoolId, ticketId)).data.unitId in request.auth.token.get('units', []);
    }

    function staffSeesTicket(schoolId, ticketId) {
      return roleIn(schoolId, ['admin', 'pimpinan'])
        || (inSchool(schoolId) && request.auth.token.get('canVerify', false) == true)
        || inTicketUnit(schoolId, ticketId);
    }

    function validAttachment() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Lampiran dari pelapor: diunggah sebelum laporan dikirim, atau saat diminta melengkapi data.
    match /schools/{schoolId}/tickets/{ticketId}/lampiran/{fileName} {
      allow get: if ownsTicket(schoolId, ticketId) || staffSeesTicket(schoolId, ticketId);
      allow create: if roleIn(schoolId, ['siswa']) && resource == null && validAttachment()
        && (!firestore.exists(ticketPath(schoolId, ticketId))
          || (ownsTicket(schoolId, ticketId) && firestore.get(ticketPath(schoolId, ticketId)).data.status == 'perlu_dilengkapi'));
    }

    // Dokumentasi tindak lanjut dari admin atau unit penangan.
    match /schools/{schoolId}/tickets/{ticketId}/tindak-lanjut/{fileName} {
      allow get: if ownsTicket(schoolId, ticketId) || staffSeesTicket(schoolId, ticketId);
      allow create: if resource == null && validAttachment()
        && (roleIn(schoolId, ['admin']) || inTicketUnit(schoolId, ticketId));
    }

    // ============ Aplikasi 4.0.0 (dihapus setelah migrasi) ============
    match /laporan_bukti/{fileName} {
      allow get: if signedIn();
      allow create: if signedIn()
        && resource == null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /FCMImages/{fileName} {
      allow get: if signedIn();
    }
  }
}
