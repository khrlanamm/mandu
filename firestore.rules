rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Semua penulisan data MANDU 2.0 lewat Cloud Functions; rules mengatur akses baca.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn() && request.auth.token.get('sa', false) == true;
    }

    function inSchool(schoolId) {
      return signedIn() && request.auth.token.get('sid', '') == schoolId;
    }

    function hasRole(schoolId, roles) {
      return inSchool(schoolId) && request.auth.token.get('role', '') in roles;
    }

    function canVerify(schoolId) {
      return inSchool(schoolId)
        && (request.auth.token.get('role', '') == 'admin' || request.auth.token.get('canVerify', false) == true);
    }

    function inUnit(schoolId, unitId) {
      return hasRole(schoolId, ['konselor', 'petugas']) && unitId in request.auth.token.get('units', []);
    }

    // Staf yang boleh membaca laporan: admin, pimpinan, Tim Verifikasi, dan unit penangan.
    function staffSeesTicket(schoolId, unitId) {
      return hasRole(schoolId, ['admin', 'pimpinan']) || canVerify(schoolId) || inUnit(schoolId, unitId);
    }

    function ownsTicket(schoolId, ticketId) {
      return signedIn()
        && get(/databases/$(database)/documents/schools/$(schoolId)/ticketOwners/$(ticketId)).data.uid == request.auth.uid;
    }

    // Pengirim aspirasi (siswa yang masuk) untuk melacak aspirasinya sendiri.
    function ownsAspiration(schoolId, aspirationId) {
      return signedIn()
        && get(/databases/$(database)/documents/schools/$(schoolId)/aspirationOwners/$(aspirationId)).data.uid == request.auth.uid;
    }

    function readsAspirationInbox(schoolId) {
      return hasRole(schoolId, ['admin', 'pimpinan']) || canVerify(schoolId);
    }

    // ===================== MANDU 2.0 =====================

    // Konfigurasi platform (kontak darurat, katalog kategori).
    match /platform/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      // Kotak masuk notifikasi: pemilik boleh menandai dibaca atau menghapus.
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // Artikel Edukasi yang disimpan pengguna.
      match /bookmarks/{articleId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['scope', 'schoolId', 'title', 'createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      // Token FCM dikelola lewat account-registerDevice.
      match /devices/{deviceId} {
        allow read, write: if false;
      }
    }

    // Edukasi global: semua pengguna yang masuk membaca artikel terbit.
    // Edukasi global. Artikel lama aplikasi 4.0.0 diberi field `published` saat migrasi (tahap 7).
    match /articles/{articleId} {
      allow read: if signedIn() && (resource.data.published == true || isSuperadmin());
      allow write: if false;
    }

    // Indeks kode sekolah hanya dibaca Cloud Functions (schools-lookup).
    match /schoolCodes/{code} {
      allow read, write: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isSuperadmin() || hasRole(resource.data.schoolId, ['admin']);
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if inSchool(schoolId) || isSuperadmin();
      allow write: if false;

      // Siswa yang masih menunggu persetujuan tetap bisa membaca keanggotaannya sendiri.
      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid)
          || hasRole(schoolId, ['admin', 'pimpinan'])
          || isSuperadmin();
        allow write: if false;
      }

      match /units/{unitId} {
        allow read: if inSchool(schoolId) || isSuperadmin();
        allow write: if false;
      }

      // Laporan tidak memuat identitas pelapor; superadmin tidak membaca isi laporan.
      match /tickets/{ticketId} {
        allow read: if staffSeesTicket(schoolId, resource.data.unitId) || ownsTicket(schoolId, ticketId);
        allow write: if false;

        // Pelapor hanya melihat riwayat publik; catatan internal khusus staf.
        match /timeline/{eventId} {
          allow read: if staffSeesTicket(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/tickets/$(ticketId)).data.unitId)
            || (resource.data.visibility == 'public' && ownsTicket(schoolId, ticketId));
          allow write: if false;
        }
      }

      // Edukasi sekolah: siswa membaca yang sudah terbit; admin & konselor juga melihat draf.
      match /articles/{articleId} {
        allow read: if inSchool(schoolId)
          && (resource.data.published == true || hasRole(schoolId, ['admin', 'konselor']));
        allow write: if false;
      }

      // Butuh Bantuan: hanya siswa pemilik dan konselor sekolah (admin melihat angka agregat saja).
      match /helpRequests/{requestId} {
        allow read: if (signedIn() && resource.data.studentUid == request.auth.uid) || hasRole(schoolId, ['konselor']);
        allow write: if false;
      }

      // Curhat: siswa pemilik, konselor yang menangani, dan (sebelum diambil) konselor lain.
      match /conversations/{conversationId} {
        function conversation() {
          return get(/databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId)).data;
        }
        function isStudent() { return signedIn() && resource.data.studentUid == request.auth.uid; }
        function isAssigned() { return signedIn() && resource.data.counselorUid == request.auth.uid; }
        function marksRead(field) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
            && request.resource.data[field] == 0;
        }

        allow read: if isStudent() || isAssigned()
          || (hasRole(schoolId, ['konselor']) && resource.data.counselorUid == null);
        // Satu-satunya penulisan dari aplikasi: menandai pesan sudah dibaca.
        allow update: if (isStudent() && marksRead('unreadStudent')) || (isAssigned() && marksRead('unreadCounselor'));
        allow create, delete: if false;

        match /messages/{messageId} {
          allow read: if signedIn()
            && (conversation().studentUid == request.auth.uid || conversation().counselorUid == request.auth.uid);
          allow create: if signedIn()
            && conversation().status != 'selesai'
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasAll(['senderUid', 'senderRole', 'text', 'createdAt'])
            && request.resource.data.keys().hasOnly(['senderUid', 'senderRole', 'text', 'imagePath', 'createdAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000
            && (request.resource.data.text.size() > 0 || request.resource.data.get('imagePath', null) != null)
            && ((conversation().studentUid == request.auth.uid && request.resource.data.senderRole == 'siswa')
              || (conversation().counselorUid == request.auth.uid && request.resource.data.senderRole == 'konselor'));
          allow update, delete: if false;
        }

        // Identitas asli siswa (bila dibuka) — hanya konselor yang menangani.
        match /private/{docId} {
          allow read: if signedIn() && conversation().counselorUid == request.auth.uid;
          allow write: if false;
        }

        // Catatan kasus konselor, tidak pernah terlihat siswa.
        match /caseNotes/{noteId} {
          allow read: if signedIn() && conversation().counselorUid == request.auth.uid;
          allow create: if signedIn() && conversation().counselorUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['text', 'riskLevel', 'authorName', 'createdAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 4000
            && request.resource.data.riskLevel in ['tidak_ada', 'perhatian', 'tinggi']
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      // Aspirasi tanpa identitas pengirim: staf pengelola, siswa (hanya yang tampil di papan), atau pengirimnya.
      match /aspirations/{aspirationId} {
        allow read: if readsAspirationInbox(schoolId)
          || (hasRole(schoolId, ['siswa']) && resource.data.board == 'published')
          || ownsAspiration(schoolId, aspirationId);
        allow write: if false;

        // Nama & kelas pengirim yang tidak merahasiakan identitas.
        match /private/{docId} {
          allow read: if readsAspirationInbox(schoolId);
          allow write: if false;
        }

        // Dukungan papan aspirasi: siswa hanya melihat dukungannya sendiri.
        match /supports/{uid} {
          allow read: if inSchool(schoolId) && request.auth.uid == uid;
          allow write: if false;
        }
      }

      match /aspirationOwners/{aspirationId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // Pemetaan laporan → pelapor, hanya bisa dibaca pelapor sendiri.
      match /ticketOwners/{ticketId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      match /counters/{counterId} {
        allow read, write: if false;
      }
    }

    // ============ Aplikasi 4.0.0 (dihapus setelah migrasi) ============

    function isLegacyAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validNewReport(data) {
      return data.keys().hasOnly([
          'id', 'userId', 'peran', 'tanggalBullying', 'lokasi', 'frekuensi',
          'deskripsi', 'nomorWhatsapp', 'urlBukti', 'timestamp', 'status'
        ])
        && data.userId == request.auth.uid
        && data.status == 'terlapor'
        && data.peran in ['Korban', 'Saksi']
        && data.tanggalBullying is string && data.tanggalBullying.size() <= 20
        && data.lokasi is string && data.lokasi.size() <= 500
        && data.frekuensi is string && data.frekuensi.size() <= 50
        && data.deskripsi is string && data.deskripsi.size() <= 5000
        && data.nomorWhatsapp is string && data.nomorWhatsapp.size() <= 20
        && (data.get('urlBukti', null) == null || data.urlBukti is string)
        && data.timestamp is timestamp;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
    }

    match /reports/{reportId} {
      allow read: if isLegacyAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && validNewReport(request.resource.data);
      allow update: if isLegacyAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['terlapor', 'ditangani'];
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'terlapor';
    }
  }
}
